# HuggingFace Token（話者分離に必要）
# https://huggingface.co/settings/tokens で取得
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxx

# 音声出力形式 (mp3 or m4a)
OUTPUT_FORMAT=mp3

# ラウドネス正規化ターゲット (LUFS)
TARGET_LUFS=-16

# Whisperモデルサイズ (large-v3 推奨、GPUメモリ不足時は medium)
WHISPER_MODEL=large-v3

# VADパラメータ（通常変更不要）
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=500
VAD_SPEECH_PAD_MS=200
